<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="assets/css/accueil_stylesheet.css" rel="stylesheet"/>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>


<body>

{% include 'partials/_header.html.twig' %}

<main class="main-container home-page">
    <section class="home-intro">
        <h1>Offres de stage</h1>
        <p>Trouvez des opportunites adaptees a votre profil et candidatez rapidement.</p>
    </section>

    <aside class="sidebar">

        {# AFFICHAGE DES OFFRES #}
        {% if searchQuery is defined and searchQuery is not empty %}
            <p class="search-result-text">
                Résultats pour: <strong>{{ searchQuery|e }}</strong>
            </p>
        {% endif %}

        {% if offres is not empty %}
            {% for offre in offres %}
                <div class="list-offer">    
                    {% if isStudent %}
                        <button class="btn-action star toggle-wishlist {{ offre.is_in_wishlist ? 'active' : '' }}" 
                                data-id="{{ offre.Id_offre }}" 
                                data-action="{{ offre.is_in_wishlist ? 'delete' : 'add' }}"
                                title="Favoris">
                            <i class="{{ offre.is_in_wishlist ? 'fa-solid' : 'fa-regular' }} fa-star"></i>
                        </button>
                    {% endif %}        
                    <h2>{{ offre.Titre|default('Titre non défini')|e }}</h2>
                    <h4>Entreprise : </h4>
                    <p><a href="/company?id={{ offre.Id_entreprise }}" class="entreprise-link">{{ offre.Nom_entreprise|default('Entreprise inconnue')|e }}</a></p>
                    {% set avg = offre.note_moyenne|default(0) %}
                    {% set avgRounded = avg|round(0, 'common') %}
                    <div class="home-rating" aria-label="Note moyenne {{ avg }}/5">
                        <span class="home-rating-label">Note entreprise :</span>
                        {% for i in 1..5 %}
                            <span class="home-star {{ i <= avgRounded ? 'filled' : 'empty' }}">★</span>
                        {% endfor %}
                        <span class="home-rating-meta">{{ avg }}/5 ({{ offre.total_votes|default(0) }} avis)</span>
                    </div>
                    <h4>Durée du stage : </h4>
                    <p>{{ offre.Duree_mois|default('Durée à définir')|e }} Mois</p>
                    <h4>Rémunération : </h4>
                    <p>{{ offre.Remuneration|default('Rémunération à définir')|e }} €</p>
                    <h4>Nombre de postes disponibles : </h4>
                    <p>{{ offre.Nombre_place|default('Nombre de places à définir')|e }}</p><br>
                    <h3>Description du poste : </h3>
                    <p>{{ offre.Description|default('Pas de description')|e }}</p>
                    {% if isAuth and session_role == 0 %}
                        <a href="/candidater?id_offre={{ offre.Id_offre }}" class="btn-candidate">Postuler</a>
                    {% else %}
                        <a href="/candidater?id_offre={{ offre.Id_offre }}" class="btn-candidate">Détails</a>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <div class="list-offer">
                <h3>Aucune offre trouvée</h3>
            </div>
        {% endif %}

        {# PAGINATION #}
        {% if totalPages is defined and totalPages > 1 %}
            <div class="pagination-container">

                {# Bouton Précédent #}
                {% if pageActuelle > 1 %}
                    <a href="/?page={{ pageActuelle - 1 }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn pagination-nav">
                        Précédent
                    </a>
                {% endif %}

                {# Numéros #}
                {% for i in 1..totalPages %}
                    <a href="/?page={{ i }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn {{ i == pageActuelle ? 'is-active' : '' }}">
                        {{ i }}
                    </a>
                {% endfor %}

                {# Bouton Suivant #}
                {% if pageActuelle < totalPages %}
                    <a href="/?page={{ pageActuelle + 1 }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn pagination-nav">
                        Suivant
                    </a>
                {% endif %}

            </div>
        {% endif %}

    </aside>
</main>

{% include 'partials/_footer.html.twig' %}

<script src="assets/js/Home_style2.js"></script>

</body>

</html>
