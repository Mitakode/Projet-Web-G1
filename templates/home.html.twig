{#
    Template: home.html.twig
    Purpose: Public offer listing with search + pagination.
    Data: Provided by HomeController::index (and auth vars are typically injected by View).
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Career Quest</title>
    <meta name="description" content="Find the perfect match among our internship offers.">
    <link href="assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="assets/css/accueil_stylesheet.css" rel="stylesheet"/>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>


<body>

{% include 'partials/_header.html.twig' %}

<main class="main-container home-page">
    <section class="home-intro">
        <h1>Internship offers</h1>
        <p>Find opportunities tailored to your profile and apply quickly.</p>
    </section>

    <aside class="sidebar">

        {# OFFER LISTING #}
        {% if searchQuery is defined and searchQuery is not empty %}
            <p class="search-result-text">
                Results for: <strong>{{ searchQuery|e }}</strong>
            </p>
        {% endif %}

        {% if offres is not empty %}
            {% for offre in offres %}
                <div class="list-offer">          
                    <h2>{{ offre.Titre|default('Untitled')|e }}</h2>
                    <h4>Company: </h4>
                    <p><a href="/company?id={{ offre.Id_entreprise }}" class="entreprise-link">{{ offre.Nom_entreprise|default('Unknown company')|e }}</a></p>
                    {% set avg = offre.note_moyenne|default(0) %}
                    {% set avgRounded = avg|round(0, 'common') %}
                    <div class="home-rating" aria-label="Average rating {{ avg }}/5">
                        <span class="home-rating-label">Company rating:</span>
                        {% for i in 1..5 %}
                            <span class="home-star {{ i <= avgRounded ? 'filled' : 'empty' }}">★</span>
                        {% endfor %}
                        <span class="home-rating-meta">{{ avg }}/5 ({{ offre.total_votes|default(0) }} reviews)</span>
                    </div>
                    <h4>Internship duration: </h4>
                    <p>{{ offre.Duree_mois|default('TBD')|e }} months</p>
                    <h4>Compensation: </h4>
                    <p>{{ offre.Remuneration|default('TBD')|e }} €</p>
                    <h4>Open positions: </h4>
                    <p>{{ offre.Nombre_place|default('TBD')|e }}</p><br>
                    <h3>Position description: </h3>
                    <p>{{ offre.Description|default('No description')|e }}</p>
                    {% if isAuth and session_role == 0 %}
                        <a href="/candidater?id_offre={{ offre.Id_offre }}" class="btn-candidate">Apply</a>
                    {% else %}
                        <a href="/candidater?id_offre={{ offre.Id_offre }}" class="btn-candidate">Details</a>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <div class="list-offer">
                <h3>No offers found</h3>
            </div>
        {% endif %}

        {# PAGINATION #}
        {% if totalPages is defined and totalPages > 1 %}
            <div class="pagination-container">

                {# Previous button #}
                {% if pageActuelle > 1 %}
                    <a href="/?page={{ pageActuelle - 1 }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn pagination-nav">
                        Previous
                    </a>
                {% endif %}

                {# Page numbers #}
                {% for i in 1..totalPages %}
                    <a href="/?page={{ i }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn {{ i == pageActuelle ? 'is-active' : '' }}">
                        {{ i }}
                    </a>
                {% endfor %}

                {# Next button #}
                {% if pageActuelle < totalPages %}
                    <a href="/?page={{ pageActuelle + 1 }}{% if searchQuery is defined and searchQuery is not empty %}&query={{ searchQuery|url_encode }}{% endif %}"
                       class="pagination-btn pagination-nav">
                        Next
                    </a>
                {% endif %}

            </div>
        {% endif %}

    </aside>
</main>

{% include 'partials/_footer.html.twig' %}

<script src="assets/js/Home_style2.js"></script>

</body>

</html>
