<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet" />
    <link href="/assets/css/connexion-stylesheet.css" rel="stylesheet" />
</head>

<body>

{% include 'partials/_header.html.twig' %}

<section>
    <div class="auth-container">

        <div class="auth-box">
            <h1>Connexion</h1>
            {% if error %}
                <p class="auth-error">{{ error }}</p>
            {% endif %}
            <form action="/login" method="POST">
                <label>Adresse email</label>
                <input type="email" name="email" required>

                <label>Mot de passe</label>
                <input type="password" name="password" required>

                <div class="checkbox-group">
                    <input type="checkbox"> <span>Rester connecté</span>
                </div>

                <a href="#" class="forgot-pwd">Mot de passe oublié ?</a>
                <button type="submit" class="btn">Connexion</button>
            </form>
        </div>

        <div class="vertical-divider"></div>

        <div class="auth-box">
            <h1>Inscription</h1>
            <form>
                <label>Adresse email</label>
                <input type="email">

                <label>Mot de passe</label>
                <input type="password">

                <label>Confirmer le mot de passe</label>
                <input type="password">

                <div class="checkbox-group">
                    <input type="checkbox"> <span>Accepter les conditions générales d'utilisation</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox"> <span>Rester connecté</span>
                </div>

                <button type="submit" class="btn">Créer le compte</button>
            </form>
        </div>
    </div>
</section>

{% include 'partials/_footer.html.twig' %}

</body>

</html>
