{#
    Template: liste_offres.html.twig
    Purpose: Back-office offer list with pagination.
    Data: Provided by DashboardController::listOffre.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Back-office offer list.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_stages.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back" style="margin-left:10px;">Back</a>
    <h2>Offer list ({{ totalElements is defined ? totalElements : offres|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Compensation (€/month)</th>
                <th>Offer date</th>
                <th>Duration (months)</th>
                <th>Open positions</th>
                <th>Company</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for o in offres %}
            <tr>
                <td>{{ o.Titre }}</td>
                <td>{{ o.Description }}</td>
                <td>{{ o.Remuneration }}</td>
                <td>{{ o.Date_offre }}</td>
                <td>{{ o.Duree_mois }}</td>
                <td>{{ o.Nombre_place }}</td>
                <td>
                    {% if o.Id_entreprise is defined and o.Id_entreprise %}
                        <a class="entreprise-link" href="/company?id={{ o.Id_entreprise }}">{{ o.Nom_entreprise|default('Entreprise') }}</a>
                    {% else %}
                        {{ o.Nom_entreprise|default('Inconnue') }}
                    {% endif %}
                </td>
                <td>
                    <a href="/offres_de_stages?id={{ o.Id_offre }}" class="btn-edit">Edit</a>
                    <a href="/dashboard?id-offre={{ o.Id_offre }}" class="btn-edit">Details</a>
                    <form method="POST" action="/offres_de_stages" style="display:inline"
                            onsubmit="return confirm('Delete {{ o.Titre }}?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ o.Id_offre }}">
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="10">No offers found.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container">

            {% if pageActuelle > 1 %}
                <a href="/offer_list?page={{ pageActuelle - 1 }}" class="pagination-btn pagination-nav">
                    Précédent
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/offer_list?page={{ i }}" class="pagination-btn {{ i == pageActuelle ? 'is-active' : '' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/offer_list?page={{ pageActuelle + 1 }}" class="pagination-btn pagination-nav">
                    Suivant
                </a>
            {% endif %}

        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
