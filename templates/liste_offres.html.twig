<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_stages.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" style="margin-left:10px;">
        <button class="btn-back">Retour</button>
    </a>
    <h2>Liste des offres ({{ offres|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Rémunération (€/mois)</th>
                <th>Date de l'offre</th>
                <th>Durée (mois)</th>
                <th>Nombre de places</th>
                <th>Entreprise</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for o in offres %}
            <tr>
                <td>{{ o.Titre }}</td>
                <td>{{ o.Description }}</td>
                <td>{{ o.Remuneration }}</td>
                <td>{{ o.Date_offre }}</td>
                <td>{{ o.Duree_mois }}</td>
                <td>{{ o.Nombre_place }}</td>
                <td>{{ o.Nom_entreprise|default('Inconnue') }}</td>
                <td>
                    <a href="/offres_de_stages?id={{ o.Id_offre }}">
                        <button class="btn-edit">Modifier</button>
                    </a>
                    <a href="/dashboard?id-offre={{ o.Id_offre }}">
                        <button class="btn-edit">Détails</button>
                    </a>
                    <form method="POST" action="/offres_de_stages" style="display:inline"
                            onsubmit="return confirm('Supprimer {{ o.Titre }} ?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ o.Id_offre }}">
                        <button type="submit" class="btn-delete">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="10">Aucune offre trouvée.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
