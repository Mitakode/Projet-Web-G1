{#
    Template: liste_pilotes.html.twig
    Purpose: Back-office pilot list with pagination.
    Data: Provided by DashboardController::listPilotes.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Back-office pilot list.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_pilote.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back">Retour</a>
    <form method="GET" action="/pilotes_list" style="display:flex; gap:10px; align-items:center; margin: 16px 0;">
        <input type="text" name="search" value="{{ search|default('') }}"
               placeholder="Rechercher un pilote..." class="search-bar">
        <button type="submit" class="btn">Rechercher</button>
    </form>

    {% if pilotes|length == 1%}
        <h2>Pilote trouvé</h2>
    {% else %}
        <h2>Liste des pilotes ({{ pilotes|length }})</h2>
    {% endif %}

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>E-mail</th>
                <th>Rôle</th>
                <th>Date naissance</th>
                <th>Formation</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for u in pilotes %}
            <tr>
                <td>{{ u.Nom }}</td>
                <td>{{ u.Prenom }}</td>
                <td>{{ u.Email }}</td>
                <td>
                    <span class="badge">
                        {% if u.Role == 0 %}Student
                        {% elseif u.Role == 1 %}Pilot
                        {% elseif u.Role == 2 %}Admin
                        {% else %}Unknown{% endif %}
                    </span>
                </td>
                <td>{{ u.Date_naissance|default('') }}</td>
                <td>{{ u.Formation|default('') }}</td>
                <td>{{ u.Description|default('') }}</td>
                <td>
                    <a href="/pilote?id={{ u.Id_user }}" class="btn-edit">Edit</a>
                    <form method="POST" action="/pilote" style="display:inline"
                          onsubmit="return confirm('Supprimer {{ u.Nom }} ?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ u.Id_user }}">
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="9">No pilots found.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container">
            {% if pageActuelle > 1 %}
                <a href="/pilotes_list?page={{ pageActuelle - 1 }}&search={{ search|default('')|url_encode }}" class="btn">
                    Précédent
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/pilotes_list?page={{ i }}&search={{ search|default('')|url_encode }}"
                   class="btn" style="{{ i == pageActuelle ? 'background:#0f2e45;' : '' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/pilotes_list?page={{ pageActuelle + 1 }}&search={{ search|default('')|url_encode }}" class="btn">
                    Suivant
                </a>
            {% endif %}
        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>