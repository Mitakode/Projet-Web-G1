{#
    Template: liste_pilotes.html.twig
    Purpose: Back-office pilot list with pagination.
    Data: Provided by DashboardController::listPilotes.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Back-office pilot list.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_pilote.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back" style="margin-left:10px;">Back</a>
    <h2>Pilot list ({{ totalElements|default(pilotes|length) }})</h2>
    <table>
        <thead>
            <tr>
                <th>Last name</th>
                <th>First name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Birth date</th>
                <th>Program</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for u in pilotes %}
            <tr>
                <td>{{ u.Nom }}</td>
                <td>{{ u.Prenom }}</td>
                <td>{{ u.Email }}</td>
                <td>
                    <span class="badge">
                        {% if u.Role == 0 %}Student
                        {% elseif u.Role == 1 %}Pilot
                        {% elseif u.Role == 2 %}Admin
                        {% else %}Unknown{% endif %}
                    </span>
                </td>
                <td>{{ u.Date_naissance|default('') }}</td>
                <td>{{ u.Formation|default('') }}</td>
                <td>{{ u.Description|default('') }}</td>
                <td>
                    <a href="/pilote?id={{ u.Id_user }}" class="btn-edit">Edit</a>
                    <form method="POST" action="/pilote" style="display:inline"
                        onsubmit="return confirm('Delete {{ u.Nom }}?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ u.Id_user }}">
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="9">No pilots found.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container" style="display:flex; justify-content:center; gap:10px; margin-top:20px;">
            {% if pageActuelle > 1 %}
                <a href="/pilotes_list?page={{ pageActuelle - 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Previous
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/pilotes_list?page={{ i }}"
                   style="padding:10px; text-decoration:none; border-radius:5px; {{ i == pageActuelle ? 'background:#17496E; color:white;' : 'background:#e0e0e0; color:black;' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/pilotes_list?page={{ pageActuelle + 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Next
                </a>
            {% endif %}
        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
