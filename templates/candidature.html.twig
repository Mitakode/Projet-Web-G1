{#
    Template: candidature.html.twig
    Purpose: Offer detail + candidature submission form + company rating widget.
    Data: Provided by CandidatureController::index and CandidatureController::submit.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Candidature - {{ offre.Titre }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="assets/css/candidature_style.css" rel="stylesheet"/>
</head>
<body>

{% include 'partials/_header.html.twig' %}

<main class="candidature-container">

    <div class="offer-details">
        <h1>{{ offre.Titre }}</h1>

        <div class="entreprise-meta">
            <strong>Entreprise :</strong> {{ offre.Nom_entreprise|default("Entreprise inconnue") }}
        </div>

        {# Backend-provided average rating + rounded version for star rendering #}
        {% set avg = offre.note_moyenne|default(0) %}
        {% set avgRounded = avg|round(0, 'common') %}
        <section class="rating-panel">
            <h3>Note de l'entreprise</h3>
            {# Visual display of the global average #}
            <div class="stars-display" aria-label="Note moyenne {{ avg }}/5">
                {% for i in 1..5 %}
                    <span class="star {{ i <= avgRounded ? 'filled' : 'empty' }}">★</span>
                {% endfor %}
                <span class="rating-meta">{{ avg }}/5 ({{ offre.total_votes|default(0) }} avis)</span>
            </div>

            {% if ratingStatus == 'saved' %}
                <p class="rating-flash success">Votre note a été sauvegardée.</p>
            {% elseif ratingStatus == 'forbidden' %}
                <p class="rating-flash error">Vous devez avoir postulé à cette offre pour la noter.</p>
            {% elseif ratingStatus == 'invalid' %}
                <p class="rating-flash error">Votre note est invalide.</p>
            {% endif %}

            {% if canRate %}
                {# Rating form: submits offer + company + a 1..5 rating #}
                <form class="rating-form" action="/?uri=/noter-entreprise" method="post">
                    <input type="hidden" name="id_offre" value="{{ offre.Id_offre }}">
                    <input type="hidden" name="id_entreprise" value="{{ offre.Id_entreprise }}">

                    {# Stars are built as reversed radios to get the classic hover effect #}
                    <div class="rating-input" role="radiogroup" aria-label="Noter cette entreprise">
                        {% for i in 5..1 %}
                            <input
                                type="radio"
                                id="note-{{ i }}"
                                name="note"
                                value="{{ i }}"
                                {{ userNote is not null and userNote == i ? 'checked' : '' }}
                                required
                            >
                            <label for="note-{{ i }}" title="{{ i }} étoile{{ i > 1 ? 's' : '' }}">★</label>
                        {% endfor %}
                    </div>

                    <button type="submit" class="rate-submit">Enregistrer ma note</button>
                </form>
            {% else %}
                {# Shown when the student cannot rate yet (no prior candidature for this company) #}
                <p class="rating-hint">La note sera disponible après avoir postulé à cette offre.</p>
            {% endif %}
        </section>
        
        <div class="offer-meta">
        <strong>Date de l'offre :</strong> {{ offre.Date_offre|date("d/m/Y") }} <br>
        <strong>Rémunération :</strong> {{ offre.Remuneration }} € <br>
        <strong>Durée :</strong> {{ offre.Duree_mois }} mois <br>
        <strong>Places disponibles :</strong> {{ offre.Nombre_place }}
        </div>

        <div class="description-content">
        <h3>Description du poste</h3>
        <p>{{ offre.Description|nl2br }}</p>
        </div>
    </div>

    {% if isAuth and session_role == 0 %}
        {% if alreadyApplied %}
            <p>Vous avez déjà postulé à cette offre.</p>
        {% else %}
            <div class="application-form">
                <h2 class="application-form-title">Postuler maintenant</h2>

                <form action="/?uri=/candidater" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id_offre" value="{{ offre.Id_offre }}">
                    <br>
                    <label class="upload-label" for="cv">CV</label>
                    <div class="file-input-wrapper">
                        <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required>
                    </div>
                    <br>
                    <label class="upload-label" for="lm">Lettre de motivation</label>
                    <div class="file-input-wrapper">
                        <input type="file" id="lm" name="lm" accept=".pdf,.doc,.docx" required>
                    </div>
                    <br><br>
                    <button type="submit" class="submit-btn">Envoyer ma candidature</button>
                </form>
            </div>
        {% endif %}

    {% elseif isAuth and session_role > 0 %}
        <p class="candidature-message">
            Vous n'avez pas les permissions requises pour postuler à cette offre.
        </p>
    {% else %}
        <p class="candidature-message">
            Connectez-vous pour postuler à cette offre.
        </p>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

<script src="/assets/js/form-validation.js"></script>

</body>
</html>
