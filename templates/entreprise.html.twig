{#
    Template: entreprise.html.twig
    Purpose: Back-office company CRUD form (create/edit).
    Data: Provided by DashboardController::Entreprise and DashboardController::addEntreprise.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CRUD — Entreprise</title>
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/CRUD_style.css" rel="stylesheet"/>
</head>
<body>

{% include 'partials/_header.html.twig' %}

<h1>{{ editEntreprise ? 'Modifier une entreprise' : 'Ajouter une entreprise' }}</h1>

{% if error %}
    <div class="form-error-box">
        {{ error }}
    </div>
{% endif %}

<form method="POST" action="/entreprise" class="main-form">
    <input type="hidden" name="action" value="{{ editEntreprise ? 'edit' : 'add' }}">
    {% if editEntreprise %}
        <input type="hidden" name="id" value="{{ editEntreprise.Id_entreprise }}">
    {% endif %}

    <label>Nom</label>
    <input type="text" name="nom" value="{{ editEntreprise.Nom|default('') }}" required>

    <label>Description</label>
    <input type="text" name="description" value="{{ editEntreprise.Description|default('') }}" required>

    <label>Adresse e-mail</label>
    <input type="email" name="email_contact" value="{{ editEntreprise.Email_contact|default('') }}" required>

    <label>Téléphone</label>
    <input type="text" name="telephone" value="{{ editEntreprise.Telephone|default('') }}">

    <label>Actif</label>
    <select name="est_actif">
        <option value="1" {{ editEntreprise.Est_actif == 1 ? 'selected' : '' }}>Oui</option>
        <option value="0" {{ editEntreprise.Est_actif == 0 ? 'selected' : '' }}>Non</option>
    </select>

    <button type="submit" class="btn btn-add">
        {{ editEntreprise ? 'Enregistrer' : 'Ajouter' }}
    </button>
    {% if editEntreprise %}
        <a href="/enterprise_list">Annuler</a>
    {% else %}
        <a href="/account">Annuler</a>
    {% endif %}
</form>

{% include 'partials/_footer.html.twig' %}

<script src="/assets/js/form-validation.js"></script>

</body>
</html>
