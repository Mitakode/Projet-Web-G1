{#
    Template: liste_entreprises.html.twig
    Purpose: Back-office company list with pagination.
    Data: Provided by DashboardController::listEntreprise.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Back-office company list.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_entreprise.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back" style="margin-left:10px;">Back</a>
    <h2>Company list ({{ totalElements|default(entreprises|length) }})</h2>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for e in entreprises %}
            <tr>
                <td>{{ e.Nom }}</td>
                <td>{{ e.Description }}</td>
                <td>{{ e.Email_contact }}</td>
                <td>{{ e.Telephone|default('') }}</td>
                <td>{{ e.Est_actif == 1 ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="/entreprise?id={{ e.Id_entreprise }}" class="btn-edit">Edit</a>
                    <form method="POST" action="/entreprise" style="display:inline"
                        onsubmit="return confirm('Delete {{ e.Nom }}?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ e.Id_entreprise }}">
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="10">No companies found.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container" style="display:flex; justify-content:center; gap:10px; margin-top:20px;">
            {% if pageActuelle > 1 %}
                <a href="/enterprise_list?page={{ pageActuelle - 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Previous
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/enterprise_list?page={{ i }}"
                   style="padding:10px; text-decoration:none; border-radius:5px; {{ i == pageActuelle ? 'background:#17496E; color:white;' : 'background:#e0e0e0; color:black;' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/enterprise_list?page={{ pageActuelle + 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Next
                </a>
            {% endif %}
        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
