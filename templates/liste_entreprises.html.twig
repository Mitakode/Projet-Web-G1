<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_entreprise.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back" style="margin-left:10px;">Retour</a>
    <h2>Liste des entreprises ({{ totalElements|default(entreprises|length) }})</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Est actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for e in entreprises %}
            <tr>
                <td>{{ e.Id_entreprise }}</td>
                <td>{{ e.Nom }}</td>
                <td>{{ e.Description }}</td>
                <td>{{ e.Email_contact }}</td>
                <td>{{ e.Telephone|default('') }}</td>
                <td>{{ e.Est_actif == 1 ? 'Oui' : 'Non' }}</td>
                <td>
                    <a href="/entreprise?id={{ e.Id_entreprise }}" class="btn-edit">Modifier</a>
                    <form method="POST" action="/entreprise" style="display:inline"
                        onsubmit="return confirm('Supprimer {{ e.Nom }} ?')">
                        <input type="hidden" name="action" value="delete">  {# ← manquait ça #}
                        <input type="hidden" name="id" value="{{ e.Id_entreprise }}">
                        <button type="submit" class="btn-delete">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="10">Aucune entreprise trouvée.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container" style="display:flex; justify-content:center; gap:10px; margin-top:20px;">
            {% if pageActuelle > 1 %}
                <a href="/enterprise_list?page={{ pageActuelle - 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Précédent
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/enterprise_list?page={{ i }}"
                   style="padding:10px; text-decoration:none; border-radius:5px; {{ i == pageActuelle ? 'background:#17496E; color:white;' : 'background:#e0e0e0; color:black;' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/enterprise_list?page={{ pageActuelle + 1 }}"
                   style="padding:10px; background:#17496E; color:white; text-decoration:none; border-radius:5px;">
                    Suivant
                </a>
            {% endif %}
        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
