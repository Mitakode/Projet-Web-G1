{#
    Partial: _stats_carousel_entreprises.html.twig
    Purpose: Company-related statistics carousel.
    Data: Expects `title` and `stats` (from StatsModel).
#}
<section class="stats-section" data-carousel-scope>
    <div class="stats-header">
        <h2>{{ title|default('Companies') }}</h2>
        <div class="stats-controls">
            <button class="stats-nav" type="button" data-carousel-prev aria-label="Previous">‹</button>
            <button class="stats-nav" type="button" data-carousel-next aria-label="Next">›</button>
        </div>
    </div>

    <div class="stats-carousel" data-carousel>
        <div class="stats-track" data-carousel-track>
            <article class="stat-card">
                <h3>Active companies</h3>
                <p class="stat-value">{{ stats.total_entreprises|default(0) }}</p>
                <p class="stat-hint">Total number of companies</p>
            </article>

            <article class="stat-card">
                <h3>Avg offers / company</h3>
                <p class="stat-value">{{ stats.avg_offres|default(0)|number_format(2, ',', ' ') }}</p>
                <p class="stat-hint">Offer distribution across companies</p>
            </article>

            <article class="stat-card">
                <h3>Top companies (offers)</h3>
                {% if stats.top_offres is empty %}
                    <p class="stat-empty">No companies available.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for entreprise in stats.top_offres %}
                            <li>
                                {{ entreprise.Nom }}
                                <span class="stat-badge">{{ entreprise.total_offres }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>

            <article class="stat-card">
                <h3>Top companies (applications)</h3>
                {% if stats.top_candidatures is empty %}
                    <p class="stat-empty">No application recorded.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for entreprise in stats.top_candidatures %}
                            <li>
                                {{ entreprise.Nom }}
                                <span class="stat-badge">{{ entreprise.total_candidatures }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>
        </div>
        <div class="stats-dots" data-carousel-dots aria-label="Carousel navigation"></div>
    </div>
</section>
