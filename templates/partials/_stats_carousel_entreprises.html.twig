{#
    Partial: _stats_carousel_entreprises.html.twig
    Purpose: Company-related statistics carousel.
    Data: Expects `title` and `stats` (from StatsModel).
#}
<section class="stats-section" data-carousel-scope>
    <div class="stats-header">
        <h2>{{ title|default('Entreprises') }}</h2>
        <div class="stats-controls">
            <button class="stats-nav" type="button" data-carousel-prev aria-label="Précédent">‹</button>
            <button class="stats-nav" type="button" data-carousel-next aria-label="Suivant">›</button>
        </div>
    </div>

    <div class="stats-carousel" data-carousel>
        <div class="stats-track" data-carousel-track>
            <article class="stat-card">
                <h3>Entreprises actives</h3>
                <p class="stat-value">{{ stats.total_entreprises|default(0) }}</p>
                <p class="stat-hint">Nombre total d'entreprises</p>
            </article>

            <article class="stat-card">
                <h3>Moyenne d'offres / entreprise</h3>
                <p class="stat-value">{{ stats.avg_offres|default(0)|number_format(2, ',', ' ') }}</p>
                <p class="stat-hint">Répartition des offres sur les entreprises</p>
            </article>

            <article class="stat-card">
                <h3>Top entreprises (offres)</h3>
                {% if stats.top_offres is empty %}
                    <p class="stat-empty">Aucune entreprise disponible.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for entreprise in stats.top_offres %}
                            <li>
                                {{ entreprise.Nom }}
                                <span class="stat-badge">{{ entreprise.total_offres }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>

            <article class="stat-card">
                <h3>Top entreprises (candidatures)</h3>
                {% if stats.top_candidatures is empty %}
                    <p class="stat-empty">Aucune candidature enregistrée.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for entreprise in stats.top_candidatures %}
                            <li>
                                {{ entreprise.Nom }}
                                <span class="stat-badge">{{ entreprise.total_candidatures }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>
        </div>
        <div class="stats-dots" data-carousel-dots aria-label="Navigation du carrousel"></div>
    </div>
</section>
