{#
    Partial: _stats_carousel.html.twig
    Purpose: Generic statistics carousel component.
    Data: Expects `title` and a `stats` object with keys used below.
#}
<section class="stats-section" data-carousel-scope>
    <div class="stats-header">
        <h2>{{ title|default('Statistiques') }}</h2>
        <div class="stats-controls">
            <button class="stats-nav" type="button" data-carousel-prev aria-label="Précédent">‹</button>
            <button class="stats-nav" type="button" data-carousel-next aria-label="Suivant">›</button>
        </div>
    </div>

    <div class="stats-carousel" data-carousel>
        <div class="stats-track" data-carousel-track>
        <article class="stat-card">
            <h3>Offres disponibles</h3>
            <p class="stat-value">{{ stats.total_offres|default(0) }}</p>
            <p class="stat-hint">Nombre total d'offres dans la base</p>
        </article>

        <article class="stat-card">
            <h3>Total des candidatures</h3>
            <p class="stat-value">{{ stats.total_candidatures|default(0) }}</p>
            <p class="stat-hint">Toutes les candidatures enregistrées</p>
        </article>

        <article class="stat-card">
            <h3>Moy. candidatures / offre</h3>
            <p class="stat-value">{{ stats.avg_candidatures|default(0)|number_format(2, ',', ' ') }}</p>
            <p class="stat-hint">Calculée sur l'ensemble des offres</p>
        </article>

        <article class="stat-card">
            <h3>Répartition par durée</h3>
            {% if stats.duree_repartition is empty %}
                <p class="stat-empty">Aucune donnée disponible.</p>
            {% else %}
                <ul class="stat-list">
                    {% for item in stats.duree_repartition %}
                        <li>{{ item.duree_mois }} mois : {{ item.total }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

        <article class="stat-card">
            <h3>Top favoris</h3>
            {% if stats.top_wishlist is empty %}
                <p class="stat-empty">Aucune offre ajoutée.</p>
            {% else %}
                <ul class="stat-list">
                    {% for offer in stats.top_wishlist %}
                        <li>
                            <a class="stat-link" href="/candidater?id_offre={{ offer.Id_offre }}">
                                {{ offer.Titre }}{% if offer.Nom_entreprise %} — {{ offer.Nom_entreprise }}{% endif %}
                            </a>
                            <span class="stat-badge">{{ offer.total_wishlist }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

        <article class="stat-card">
            <h3>Top candidatures</h3>
            {% if stats.top_candidatures is empty %}
                <p class="stat-empty">Aucune candidature enregistrée.</p>
            {% else %}
                <ul class="stat-list">
                    {% for offer in stats.top_candidatures %}
                        <li>
                            <a class="stat-link" href="/candidater?id_offre={{ offer.Id_offre }}">
                                {{ offer.Titre }}{% if offer.Nom_entreprise %} — {{ offer.Nom_entreprise }}{% endif %}
                            </a>
                            <span class="stat-badge">{{ offer.total_candidatures }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>
        </div>
        <div class="stats-dots" data-carousel-dots aria-label="Navigation du carrousel"></div>
    </div>
</section>
