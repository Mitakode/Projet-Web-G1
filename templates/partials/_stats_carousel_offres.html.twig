{#
    Partial: _stats_carousel_offres.html.twig
    Purpose: Offer-related statistics carousel.
    Data: Expects `title` and `stats` (from StatsModel).
#}
<section class="stats-section" data-carousel-scope>
    <div class="stats-header">
        <h2>{{ title|default('Offers') }}</h2>
        <div class="stats-controls">
            <button class="stats-nav" type="button" data-carousel-prev aria-label="Previous">‹</button>
            <button class="stats-nav" type="button" data-carousel-next aria-label="Next">›</button>
        </div>
    </div>

    <div class="stats-carousel" data-carousel>
        <div class="stats-track" data-carousel-track>
            <article class="stat-card">
                <h3>Available offers</h3>
                <p class="stat-value">{{ stats.total_offres|default(0) }}</p>
                <p class="stat-hint">Total number of offers in the database</p>
            </article>

            <article class="stat-card">
                <h3>Total applications</h3>
                <p class="stat-value">{{ stats.total_candidatures|default(0) }}</p>
                <p class="stat-hint">All recorded applications</p>
            </article>

            <article class="stat-card">
                <h3>Avg applications / offer</h3>
                <p class="stat-value">{{ stats.avg_candidatures|default(0)|number_format(2, ',', ' ') }}</p>
                <p class="stat-hint">Computed across all offers</p>
            </article>

            <article class="stat-card">
                <h3>Duration breakdown</h3>
                {% if stats.duree_repartition is empty %}
                    <p class="stat-empty">No data available.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for item in stats.duree_repartition %}
                            <li>{{ item.duree_mois }} months: {{ item.total }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>

            <article class="stat-card">
                <h3>Top wish-list</h3>
                {% if stats.top_wishlist is empty %}
                    <p class="stat-empty">No offer added.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for offer in stats.top_wishlist %}
                            <li>
                                <a class="stat-link" href="/candidater?id_offre={{ offer.Id_offre }}">
                                    {{ offer.Titre }}{% if offer.Nom_entreprise %} — {{ offer.Nom_entreprise }}{% endif %}
                                </a>
                                <span class="stat-badge">{{ offer.total_wishlist }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>

            <article class="stat-card">
                <h3>Top applications</h3>
                {% if stats.top_candidatures is empty %}
                    <p class="stat-empty">No application recorded.</p>
                {% else %}
                    <ul class="stat-list">
                        {% for offer in stats.top_candidatures %}
                            <li>
                                <a class="stat-link" href="/candidater?id_offre={{ offer.Id_offre }}">
                                    {{ offer.Titre }}{% if offer.Nom_entreprise %} — {{ offer.Nom_entreprise }}{% endif %}
                                </a>
                                <span class="stat-badge">{{ offer.total_candidatures }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>
        </div>
        <div class="stats-dots" data-carousel-dots aria-label="Carousel navigation"></div>
    </div>
</section>
