{#
    Partial: _header.html.twig
    Purpose: Main navigation header (desktop + mobile).
    Data: Typically expects `isAuth` and a user object (some pages pass `user`, View injects `authUser`).
#}
<header class="navbar">
    <div class="logo">
        <a href="/">
            <img src="/assets/images/logo.png" alt="Career Quest logo"/>
        </a>
    </div>

    <div class="nav-panel">
        <div class="search-container">
            <form action="/" method="GET">
                <input type="text" name="query" placeholder="Search for an internship" class="search-bar" value="{{ searchQuery|default('')|e }}"/>
            </form> 
        </div>
        <div class="nav-actions">
            <a href="/companies" class="nav-cta company-btn" aria-label="View companies">
                <span class="label">Companies</span>
            </a>

            <div class="account">
            {% if isAuth %}
                    <input type="checkbox" id="account-menu-toggle" class="account-menu-toggle" aria-label="Open account menu">
                    <label for="account-menu-toggle" class="account-menu-button" aria-hidden="true">
                        <div class="user-icon">
                            <img src="/assets/images/user_icon.svg" alt="User account icon"/>
                        </div>
                        <span class="account-name">{{ user.Prenom|default('My account') }}</span>
                        <img class="account-arrow" src="/assets/images/fleche-droite.png" alt="Open account menu"/>
                    </label>
                <div class="account-menu">
                    <a href="/account" class="account-menu-item">My account</a>
                    <a href="/logout" class="account-menu-item">Log out</a>
                </div>
            {% else %}
                    <a href="/login" class="account-button">
                        <span class="account-text">Log in</span>
                    </a>
            {% endif %}
            </div>
        </div>
    </div>

    <input type="checkbox" id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Open mobile menu">
    <label for="mobile-menu-toggle" class="mobile-fab" aria-hidden="true">
        <span></span>
    </label>

    <div class="mobile-menu">
        {% if isAuth %}
            <a class="mobile-menu-item" href="/account">
                <img src="/assets/images/user_icon.svg" alt="My account"/>
                <span>My account</span>
            </a>
            <a class="mobile-menu-item" href="/logout">
                <span>Log out</span>
            </a>
        {% else %}
            <a class="mobile-menu-item mobile-menu-item--cta" href="/login">
                <img src="/assets/images/user_icon.svg" alt="Log in"/>
                <span>Log in</span>
            </a>
        {% endif %}
        <label class="mobile-menu-item" for="mobile-search-toggle">
            <img src="/assets/images/loupe.png" alt="Search"/>
            <span>Search</span>
        </label>
    </div>

    <input type="checkbox" id="mobile-search-toggle" class="mobile-search-toggle" aria-label="Open search">
    <div class="mobile-search">
        <label class="mobile-search-backdrop" for="mobile-search-toggle" aria-hidden="true"></label>
        <div class="mobile-search-box">
            <label for="mobile-search-input" class="mobile-search-title">Search</label>
            <form action="/" method="GET">
                <input id="mobile-search-input" type="text" name="query" placeholder="Search" class="search-bar" value="{{ searchQuery|default('')|e }}"/>
            </form>
        </div>
    </div>
</header>
