<header class="navbar">
    <div class="logo">
        <a href="/">
            <img src="/assets/images/logo.png" alt="Logo de Career Quest"/>
        </a>
    </div>

    <div class="search-container">
        <form method="GET" action="/">
            <input type="text" name="query" placeholder="Rechercher un stage" class="search-bar" value="{{ searchQuery|default('')|e }}"/>
        </form>
    </div>

    <div class="account">
        {% if isAuth %}
            <a href="/account">
                <div class="user-icon">
                    <img src="/assets/images/user_icon.svg" alt="Icône de compte utilisateur"/>
                </div>
                <span class="account-text">Mon compte</span>
            </a>
        {% else %}
            <a href="/login" class="account-button">
                <span class="account-text">Connexion</span>
            </a>
        {% endif %}
    </div>
</header>
