{#
    Template: eleve.html.twig
    Purpose: Back-office student CRUD form (create/edit).
    Data: Provided by DashboardController::index (edit) and DashboardController::addEleve (create).
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CRUD — User</title>
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/CRUD_style.css" rel="stylesheet"/>
</head>
<body>

{% include 'partials/_header.html.twig' %}

<h1>{{ editUser ? 'Edit user' : 'Add a user' }}</h1>

<form method="POST" action="/eleve" class="main-form">
    <input type="hidden" name="action" value="{{ editUser ? 'edit' : 'add' }}">
    {% if editUser %}
        <input type="hidden" name="id" value="{{ editUser.Id_user }}">
    {% endif %}

    <label>Last name</label>
    <input type="text" name="nom" value="{{ editUser.Nom|default('') }}" required>

    <label>First name</label>
    <input type="text" name="prenom" value="{{ editUser.Prenom|default('') }}" required>

    <label>Email</label>
    <input type="email" name="email" value="{{ editUser.Email|default('') }}" required>

    <label>Birth date</label>
    <input type="date" name="date_naissance" value="{{ editUser.Date_naissance|default('') }}" required>

    <label>Program</label>
    <input type="text" name="formation" value="{{ editUser.Formation|default('') }}" required>

    <label>Description</label>
    <input type="text" name="description" value="{{ editUser.Description|default('') }}" required>

    {% if session_role == 2 %}
        <label>Managed by</label>
        <select name="est_gere_par">
            {% for p in pilotes %}
                <option value="{{ p.Id_user }}" {{ editUser.est_gere_par == p.Id_user ? 'selected' : '' }}>
                    {{ p.Nom }} {{ p.Prenom }}
                </option>
            {% endfor %}
        </select>
    {% else %}
        <input type="hidden" name="est_gere_par" value="{{ editUser ? editUser.est_gere_par : pilote_id }}">
    {% endif %}

    {% if session_role == 2 %}
        <label>Role</label>
        <select name="role">
            <option value="0">Student</option>
            <option value="1">Pilot</option>
            <option value="2">Admin</option>
        </select>
    {% else %}
        <input type="hidden" name="role" value="0">
    {% endif %}

    {% if editUser %}
        <input type="hidden" name="Password" value="{{ editUser.Password|default('') }}">
    {% else %}
        <label>Password</label>
        <input type="password" name="Password" value="{{ editUser.Password|default('') }}" autocomplete="new-password">
    {% endif %}


    <button type="submit" class="btn btn-add">
        {{ editUser ? 'Save' : 'Add' }}
    </button>

    {% if editUser %}
        <a href="/student_list" style="margin-left:10px;">Cancel</a>
    {% else %}
        <a href="/account" style="margin-left:10px;">Cancel</a>
    {% endif %}
    
</form>
{% if editUser %}
    {% set stages = stagesEleve|default(editUser.stages|default([])) %}

    <section class="main-form candidatures-section">
        <h2>Student applications</h2>

        {% if stages is not empty %}
            <ul class="candidatures-list">
                {% for stage in stages %}
                    <li class="candidature-item">
                        {% if stage.Id_offre is defined and stage.Id_offre is not empty %}
                            <a href="/candidater?id_offre={{ stage.Id_offre }}" class="btn-annonce">
                                View listing
                            </a>
                        {% endif %}

                        <strong class="candidature-titre">
                            {{ stage.offre.titre|default('Untitled internship') }}
                        </strong>
                        
                        <div class="candidature-actions">
                            {% if stage.Cv is defined and stage.Cv is not empty %}
                                {% set cvPath = stage.Cv starts with '/uploads/' ? stage.Cv : '/uploads/' ~ stage.Cv %}
                                <a href="{{ cvPath }}" target="_blank" class="btn-document">
                                    View CV
                                </a>
                            {% endif %}
                            
                            {% if stage.LM is defined and stage.LM is not empty %}
                                {% set lmPath = stage.LM starts with '/uploads/' ? stage.LM : '/uploads/' ~ stage.LM %}
                                <a href="{{ lmPath }}" target="_blank" class="btn-document">
                                    View cover letter
                                </a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="candidatures-empty">No applications associated with this student yet.</p>
        {% endif %}
    </section>
{% endif %}

{% include 'partials/_footer.html.twig' %}

<script src="/assets/js/form-validation.js"></script>

</body>
</html>
