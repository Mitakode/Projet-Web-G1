<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/pannel-pilote-stylesheet.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<section>
    <div class="search-recherche">
        <img src="/assets/images/loupe.png" alt="Rechercher"/>
        <input type="recherche" placeholder="Rechercher parmi les listes...">
    </div>
    <hr>
    <div class="auth-containers">

        <div class="auth-container">
            <a href="/eleve/create"><button type="button" class="btn"> + Créer un élève</button></a>
            <div class="auth-box">
                <h1>Liste élèves</h1>
                <div class="list-scroll-container">
                    {% for eleve in eleves %}
                        <div class="list-item">
                            <a href="/eleve/{{ eleve.Id_user }}/delete">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Poubelle.png" alt="Supprimer"/>
                                </button>
                            </a>
                            <a href="/eleve/{{ eleve.Id_user }}/edit">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Modif.png" alt="Modifier"/>
                                </button>
                            </a>
                            <h3>{{ eleve.Prenom }} {{ eleve.Nom }}</h3>
                            <p>{{ eleve.Email }}</p>
                        </div>
                    {% else %}
                        <div class="list-item">
                            <p>Aucun élève trouvé.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="auth-container">
            <a href="/offre/create"><button type="button" class="btn"> + Ajouter une offre</button></a>
            <div class="auth-box">
                <h1>Liste offres</h1>
                <div class="list-scroll-container">
                    {% for offre in offres %}
                        <div class="list-item">
                            <a href="/offre/{{ offre.Id_offre }}/delete">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Poubelle.png" alt="Supprimer"/>
                                </button>
                            </a>
                            <a href="/offre/{{ offre.Id_offre }}/edit">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Modif.png" alt="Modifier"/>
                                </button>
                            </a>
                            <h3>{{ offre.Titre }}</h3>
                            <p>{{ offre.Description|default('Pas de description')|slice(0, 80) }}...</p>
                        </div>
                    {% else %}
                        <div class="list-item">
                            <p>Aucune offre trouvée.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="auth-container">
            <a href="/entreprise/create"><button type="button" class="btn"> + Ajouter une entreprise</button></a>
            <div class="auth-box">
                <h1>Liste entreprises</h1>
                <div class="list-scroll-container">
                    {% for entreprise in entreprises %}
                        <div class="list-item">
                            <a href="/entreprise/{{ entreprise.Id_entreprise }}/delete">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Poubelle.png" alt="Supprimer"/>
                                </button>
                            </a>
                            <a href="/entreprise/{{ entreprise.Id_entreprise }}/edit">
                                <button type="button" class="btn-list">
                                    <img src="/assets/images/icn-Modif.png" alt="Modifier"/>
                                </button>
                            </a>
                            <h3>{{ entreprise.Nom }}</h3>
                            <p>{{ entreprise.Ville|default('Ville non renseignée') }}</p>
                        </div>
                    {% else %}
                        <div class="list-item">
                            <p>Aucune entreprise trouvée.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>
</section>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
