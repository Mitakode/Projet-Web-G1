{#
    Template: company.html.twig
    Purpose: Public company profile page with offers and stats.
    Data: Provided by EntreprisePublicController::fiche.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ entreprise.Nom }} — Career Quest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/company.css" rel="stylesheet"/>
</head>
<body>
{% include 'partials/_header.html.twig' %}
<main>
    <a href="/companies" class="btn-back">← Back</a>

    <h2>{{ entreprise.Nom }}</h2>
    <p>{{ entreprise.Description }}</p>
    <p><strong>Email:</strong> {{ entreprise.Email_contact }}</p>
    <p><strong>Phone:</strong> {{ entreprise.Telephone|default('—') }}</p>
    <p><strong>Active:</strong> {{ entreprise.Est_actif == 1 ? 'Yes' : 'No' }}</p>

    <hr>
    <h3>Statistics</h3>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">{{ stats.nb_candidatures }}</div>
            <div class="stat-label">Applications received</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ stats.moyenne }}</div>
            <div class="stat-label">Average rating / 5</div>
        </div>
    </div>

    <hr>
    <h3>Internship offer(s) ({{ offres|length }})</h3>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Compensation</th>
                <th>Duration (months)</th>
                <th>Open positions</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for o in offres %}
            <tr>
                <td>{{ o.Titre }}</td>
                <td>{{ o.Remuneration }}</td>
                <td>{{ o.Duree_mois }}</td>
                <td>{{ o.Nombre_place }}</td>
                <td>{{ o.Date_offre }}</td>
            </tr>
            {% else %}
                <tr><td colspan="5">No offers for this company.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</main>
{% include 'partials/_footer.html.twig' %}
</body>
</html>
