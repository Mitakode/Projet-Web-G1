<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_entreprise.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <h2>Liste des entreprises ({{ entreprises|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Est actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for e in entreprises %}
            <tr>
                <td>{{ e.Id_entreprise }}</td>
                <td>{{ e.Nom }}</td>
                <td>{{ e.Description }}</td>
                <td>{{ e.Email }}</td>
                <td>{{ e.Telephone|default('') }}</td>
                <td>{{ e.Est_actif|default('') }}</td>
                <td>
                    <a href="/pilotes/edit?id={{ e.Id_entreprise }}">
                        <button class="btn-edit">Modifier</button>
                    </a>
                    <form method="POST" action="/pilotes/delete" style="display:inline"
                          onsubmit="return confirm('Supprimer {{ e.Nom }} ?')">
                        <input type="hidden" name="id" value="{{ e.Id_entreprise }}">
                        <button type="submit" class="btn-delete">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="10">Aucune entreprise trouvée.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
