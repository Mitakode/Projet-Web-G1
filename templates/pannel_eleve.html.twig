<!DOCTYPE html>
<html lang="fr">
    <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Career Quest</title>
	<meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/pannel_eleve_style.css" rel="stylesheet"/>
    </head>

    {% set dashboard = infos is defined ? infos : {
        user: user|default({}),
        stats: stats|default({}),
        profil: profil|default({}),
        cv: cv|default(null),
        competences: competences|default([]),
        favoris: favoris|default([]),
        dernieres_candidatures: dernieres_candidatures|default([])
    } %}

    {% set total = dashboard.stats.total|default(0) %}
    {% set enCours = dashboard.stats.en_cours|default(0) %}
    {% set refusees = dashboard.stats.refusees|default(0) %}
    {% set pctEnCours = total > 0 ? ((enCours * 100) / total)|round(0) : 0 %}
    {% set pctRefusees = total > 0 ? ((refusees * 100) / total)|round(0) : 0 %}

    <body>
        
        {% include 'partials/_header.html.twig' %}

        <main class="panel-content">

        <section class="statistiques">
            <h2>Statistiques</h2>
            <div class="stats-container">
                <p>Nombre de candidature : {{ total }}</p>
                <p>Candidatures en cours : {{ enCours }} ({{ pctEnCours }}%)</p>
                <p>Candidature refusée : {{ refusees }} ({{ pctRefusees }}%)</p>
            </div>
        </section>

        <div class="info-cv-container">
            <section class="mes-informations">
                <h2>Mes Informations</h2>

                <div class="info-item">
                    <label>Nom Prénom : {{ dashboard.user.Nom|default('') }} {{ dashboard.user.Prenom|default('') }}</label>
                </div>

                <div class="info-item">
                    <label>Date de naissance : {{ dashboard.profil.date_naissance|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Formation : {{ dashboard.profil.formation|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Mon niveau d'étude : {{ dashboard.profil.niveau_etude|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Description sur mon profil :</label>
                    <p>{{ dashboard.profil.description|default('Aucune description') }}</p>
                </div>
            </section>

            <aside class="mon-cv">
                <div class="competences-section">
                    <h3>Mes compétences</h3>
                    <div class="competences-numbers">
                        {% if dashboard.competences is not empty %}
                            {% for competence in dashboard.competences %}
                                <p>{{ competence }}</p>
                            {% endfor %}
                        {% else %}
                            <p>Aucune compétence trouvée</p>
                        {% endif %}
                    </div>
                </div>
            </aside>
        </div>

        <div class="favoris-candidatures-container">
            <section class="mes-favoris">
                <h2>Mes favoris</h2>

                {% if dashboard.favoris is not empty %}
                    {% for favori in dashboard.favoris %}
                        <div class="annonce-card">
                            <h3>{{ favori.Titre }}</h3>
                            <a href="/company?id={{ favori.Id_entreprise }}" class="entreprise-link">{{ favori.entreprise }}</a>
                            <p>{{ favori.Date_offre }}</p>
                            <a href="/candidater?id_offre={{ favori.Id_offre }}" class="btn-voir-annonce">Voir l'annonce →</a>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="annonce-card">
                        <h3>Aucun favori</h3>
                        <p>Ajoute des offres a ta wishlist pour les retrouver ici.</p>
                    </div>
                {% endif %}
            </section>

            <section class="mes-candidatures">
                <h2>Mes dernières candidatures</h2>

                {% if dashboard.dernieres_candidatures is not empty %}
                    {% for candidature in dashboard.dernieres_candidatures %}
                        {% set avg = candidature.note_moyenne|default(0) %}
                        {% set avgRounded = avg|round(0, 'common') %}
                        <div class="annonce-card">
                            <h3>{{ candidature.Titre }}</h3>
                            <a href="/company?id={{ candidature.Id_entreprise }}" class="entreprise-link">{{ candidature.entreprise }}</a>
                            <p>Candidature envoyée le {{ candidature.date_candidature }}</p>

                            <div class="rating-summary">
                                <p class="rating-title">Note moyenne de l'entreprise</p>
                                <div class="stars-display" aria-label="Note moyenne {{ avg }}/5">
                                    {% for i in 1..5 %}
                                        <span class="star {{ i <= avgRounded ? 'filled' : 'empty' }}">★</span>
                                    {% endfor %}
                                    <span class="rating-meta">{{ avg }}/5 ({{ candidature.total_votes|default(0) }} avis)</span>
                                </div>
                            </div>

                            <form class="rating-form" action="/?uri=/noter-entreprise" method="post">
                                <input type="hidden" name="id_offre" value="{{ candidature.Id_offre }}">
                                <input type="hidden" name="id_entreprise" value="{{ candidature.Id_entreprise }}">
                                <p class="rating-form-label">Ta note</p>
                                <div class="rating-input" role="radiogroup" aria-label="Noter cette entreprise">
                                    {% for i in 5..1 %}
                                        <input
                                            type="radio"
                                            id="note-{{ candidature.Id_offre }}-{{ i }}"
                                            name="note"
                                            value="{{ i }}"
                                            {{ candidature.note_utilisateur is not null and candidature.note_utilisateur == i ? 'checked' : '' }}
                                            required
                                        >
                                        <label for="note-{{ candidature.Id_offre }}-{{ i }}" title="{{ i }} étoile{{ i > 1 ? 's' : '' }}">★</label>
                                    {% endfor %}
                                </div>
                                <button type="submit">Enregistrer</button>
                            </form>

                            <a href="/candidater?id_offre={{ candidature.Id_offre }}" class="btn-voir-annonce">Voir l'annonce →</a>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="annonce-card">
                        <h3>Aucune candidature</h3>
                        <p>Tu n'as pas encore postulé à une offre.</p>
                    </div>
                {% endif %}
            </section>
        </div>

        </main>

       {% include 'partials/_footer.html.twig' %}
       
       <script src="/assets/js/form-validation.js"></script>
       
    </body>

</html>
