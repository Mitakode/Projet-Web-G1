<!DOCTYPE html>
<html lang="fr">
    <head>
    <meta charset="utf-8">
    <title>Career Quest</title>
	<meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
	<link href="main-stylesheet.css" rel="stylesheet" />
    <link href="pannel_eleve_style.css" rel="stylesheet" />
    </head>

    {% set dashboard = infos is defined ? infos : {
        user: user|default({}),
        stats: stats|default({}),
        profil: profil|default({}),
        cv: cv|default(null),
        competences: competences|default([]),
        favoris: favoris|default([]),
        dernieres_candidatures: dernieres_candidatures|default([])
    } %}

    {% set total = dashboard.stats.total|default(0) %}
    {% set enCours = dashboard.stats.en_cours|default(0) %}
    {% set refusees = dashboard.stats.refusees|default(0) %}
    {% set pctEnCours = total > 0 ? ((enCours * 100) / total)|round(0) : 0 %}
    {% set pctRefusees = total > 0 ? ((refusees * 100) / total)|round(0) : 0 %}

    <body>
        <header class="navbar">
        

            <div class="logo">
                <img src="images/logo.png" alt="Logo de Career Quest"/>
            </div>

            <div class="search-container">
                <input type="text" placeholder="Rechercher" class="search-bar"/>
            </div>

            <div class="account">
                <div class="user-icon">
                    <img src="images/user_icon.svg" alt="Icône de compte utilisateur"/>
                </div>
                <span class="account-text">
                    {{ dashboard.user.Prenom|default('') }} {{ dashboard.user.Nom|default('') }}
                </span>
            </div>
        </header>

        <section class="statistiques">
            <h2>Statistiques</h2>
            <div class="stats-container">
                <p>Nombre de candidature : {{ total }}</p>
                <p>Candidatures en cours : {{ enCours }} ({{ pctEnCours }}%)</p>
                <p>Candidature refusée : {{ refusees }} ({{ pctRefusees }}%)</p>
            </div>
        </section>

        <div class="info-cv-container">
            <section class="mes-informations">
                <h2>Mes Informations</h2>

                <div class="info-item">
                    <label>Nom Prénom : {{ dashboard.user.Nom|default('') }} {{ dashboard.user.Prenom|default('') }}</label>
                </div>

                <div class="info-item">
                    <label>Date de naissance : {{ dashboard.profil.date_naissance|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Formation : {{ dashboard.profil.formation|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Mon niveau d'étude : {{ dashboard.profil.niveau_etude|default('Non renseigné') }}</label>
                </div>

                <div class="info-item">
                    <label>Description sur mon profil :</label>
                    <p>{{ dashboard.profil.description|default('Aucune description') }}</p>
                </div>
            </section>

            <aside class="mon-cv">
                <div class="cv-section">
                    <h3>Mon CV</h3>
                    <div class="cv-placeholder">
                        {% if dashboard.cv %}
                            {% set cvPath = dashboard.cv starts with 'http' ? dashboard.cv : '/uploads/' ~ dashboard.cv %}
                            <a href="{{ cvPath }}" target="_blank" rel="noopener noreferrer">Voir mon CV</a>
                        {% else %}
                            <p>Aucun CV ajouté</p>
                        {% endif %}
                    </div>
                </div>

                <div class="competences-section">
                    <h3>Mes compétences</h3>
                    <div class="competences-numbers">
                        {% if dashboard.competences is not empty %}
                            {% for competence in dashboard.competences %}
                                <p>{{ competence }}</p>
                            {% endfor %}
                        {% else %}
                            <p>Aucune compétence trouvée</p>
                        {% endif %}
                    </div>
                </div>
            </aside>
        </div>

        <div class="favoris-candidatures-container">
            <section class="mes-favoris">
                <h2>Mes favoris</h2>

                {% if dashboard.favoris is not empty %}
                    {% for favori in dashboard.favoris %}
                        <div class="annonce-card">
                            <h3>{{ favori.Titre }}</h3>
                            <p>{{ favori.entreprise }}</p>
                            <p>{{ favori.Date_offre }}</p>
                            <a href="/offre/{{ favori.Id_offre }}">Voir l'annonce</a>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="annonce-card">
                        <h3>Aucun favori</h3>
                        <p>Ajoute des offres a ta wishlist pour les retrouver ici.</p>
                    </div>
                {% endif %}
            </section>

            <section class="mes-candidatures">
                <h2>Mes dernières candidatures</h2>

                {% if dashboard.dernieres_candidatures is not empty %}
                    {% for candidature in dashboard.dernieres_candidatures %}
                        <div class="annonce-card">
                            <h3>{{ candidature.Titre }}</h3>
                            <p>{{ candidature.entreprise }}</p>
                            <p>Candidature envoyée le {{ candidature.date_candidature }}</p>
                            <a href="/offre/{{ candidature.Id_offre }}">Voir l'annonce</a>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="annonce-card">
                        <h3>Aucune candidature</h3>
                        <p>Tu n'as pas encore postulé à une offre.</p>
                    </div>
                {% endif %}
            </section>
        </div>

        <footer class="site-footer">
            <p>
            © Career Quest | 
            <a href="/mentions-legales" class="footer-link">Mentions Légales</a>
            </p>
        </footer>
    </body>

</html>