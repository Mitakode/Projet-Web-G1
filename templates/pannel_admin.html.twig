<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/pannel_admin_style.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<div class="container">
    <section class="mes-informations">
        <h2>Mes Informations</h2>

        <div class="info-item">
            <label>Nom Prénom :</label>
            <p>{{ user.Nom }} {{ user.Prenom }}</p>
        </div>

        <div class="info-item">
            <label>Date de naissance :</label>
            <p>{{ user.Date_naissance|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Formation :</label>
            <p>{{ user.Formation|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Mon niveau d'étude :</label>
            <p>{{ user.Formation|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Description sur mon profil :</label>
            <p>{{ user.Description|default('Aucune description') }}</p>
        </div>
    </section>
</div>

<div class="admin-grid">

    <div class="admin-card">
        <h2>ELEVES</h2>
        <p>{{ eleves|length }} élèves enregistré</p>
        <a href="/student_list"><button class="admin-btn">Modifier</button></a>
        <a href="/student_creation"><button class="admin-btn">Ajouter</button></a>
    </div>

    <div class="admin-card">
        <h2>ENTREPRISES</h2>
        <p>{{ entreprises|length }} entreprises enregistré</p>
        <a href="/enterprise_list"><button class="admin-btn">Modifier</button></a>
        <a href="/add_entreprise"><button class="admin-btn">Ajouter</button></a>  
    </div>

    <div class="admin-card">
        <h2>STAGES</h2>
        <p>{{ offres|length }} stages enregistré</p>
        <a href="/offer_list"><button class="admin-btn">Modifier</button></a>
        <a href="/offres_de_stages"><button class="admin-btn">Ajouter</button></a>
    </div>

    <div class="admin-card">    
        <h2>PILOTES</h2>
        <p>{{ pilotes|length }} pilotes enregistré</p>
        <a href="/pilotes_list"><button class="admin-btn">Modifier</button></a>
        <a href="/add_pilote"><button class="admin-btn">Ajouter</button></a>
    </div>

</div>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
