<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/pannel_admin_style.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<div class="container">
    <section class="mes-informations">
        <h2>Mes Informations</h2>

        <div class="info-item">
            <label>Nom Prénom :</label>
            <p>{{ user.Nom }} {{ user.Prenom }}</p>
        </div>

        <div class="info-item">
            <label>Date de naissance :</label>
            <p>{{ user.Date_naissance|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Formation :</label>
            <p>{{ user.Formation|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Mon niveau d'étude :</label>
            <p>{{ user.Formation|default('Non renseigné') }}</p>
        </div>

        <div class="info-item">
            <label>Description sur mon profil :</label>
            <p>{{ user.Description|default('Aucune description') }}</p>
        </div>
    </section>
</div>

<div class="admin-grid">

    <div class="admin-card">
        <h2>ÉLÈVES</h2>
        <p>{{ eleves|length }} élève{% if eleves|length != 1 %}s{% endif %} enregistré{% if eleves|length != 1 %}s{% endif %}</p>  
        <div class="admin-card-buttons">
            <a href="/student_list" class="admin-btn">Modifier</a>  
            <a href="/student_creation" class="admin-btn">Ajouter</a>  
        </div>
    </div>  

    <div class="admin-card">  
        <h2>ENTREPRISES</h2>  
        <p>{{ entreprises|length }} entreprise{% if entreprises|length != 1 %}s{% endif %} enregistrée{% if entreprises|length != 1 %}s{% endif %}</p>  
        <div class="admin-card-buttons">
            <a href="/enterprise_list" class="admin-btn">Modifier</a>  
            <a href="/add_entreprise" class="admin-btn">Ajouter</a> 
        </div> 
    </div>  

    <div class="admin-card">  
        <h2>STAGES</h2>  
        <p>{{ offres|length }} stage{% if offres|length != 1 %}s{% endif %} enregistré{% if offres|length != 1 %}s{% endif %}</p>  
        <div class="admin-card-buttons">
            <a href="/offer_list" class="admin-btn">Modifier</a>  
            <a href="/offres_de_stages" class="admin-btn">Ajouter</a>  
        </div>
    </div>  

    <div class="admin-card">    
        <h2>PILOTES</h2>  
        <p>{{ pilotes|length }} pilote{% if pilotes|length != 1 %}s{% endif %} enregistré{% if pilotes|length != 1 %}s{% endif %}</p>  
        <div class="admin-card-buttons">
            <a href="/pilotes_list" class="admin-btn">Modifier</a>
            <a href="/add_pilote" class="admin-btn">Ajouter</a>
        </div>
    </div>

</div>

{% include 'partials/_footer.html.twig' %}

</body>
</html>
