<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Career Quest</title>
    <meta name="description" content="Venez rechercher la perle rare parmi nos offres d'emploi.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/css/main-stylesheet.css" rel="stylesheet"/>
    <link href="/assets/css/liste_eleve.css" rel="stylesheet"/>
</head>

<body>

{% include 'partials/_header.html.twig' %}

<main>
    <a href="/account" class="btn-back">Retour</a>
    <form method="GET" action="/student_list" style="display:flex; gap:10px; align-items:center; margin: 16px 0;">
        <input type="text" name="search" value="{{ search|default('') }}"
               placeholder="Rechercher un élève..." class="search-bar">
        <button type="submit" class="btn">Rechercher</button>
    </form>
    
    {% if users|length == 1%}
        <h2>Élève trouvé</h2>
    {% else %}
        <h2>Liste des élèves ({{ (users|length) }})</h2>
    {% endif %}

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Date naissance</th>
                <th>Formation</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
            <tr>
                <td>{{ u.Nom }}</td>
                <td>{{ u.Prenom }}</td>
                <td>{{ u.Email }}</td>
                <td>
                    <span class="badge">
                        {% if u.Role == 0 %}Élève
                        {% elseif u.Role == 1 %}Pilote
                        {% elseif u.Role == 2 %}Admin
                        {% else %}Inconnu{% endif %}
                    </span>
                </td>
                <td>{{ u.Date_naissance|default('') }}</td>
                <td>{{ u.Formation|default('') }}</td>
                <td>{{ u.Description|default('') }}</td>
                <td>
                    <a href="/eleve?id={{ u.Id_user }}" class="btn-edit">Modifier</a>
                    <form method="POST" action="/eleve" style="display:inline"
                          onsubmit="return confirm('Supprimer {{ u.Nom }} ?')">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="id" value="{{ u.Id_user }}">
                        <button type="submit" class="btn-delete">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr><td colspan="9">Aucun utilisateur trouvé.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages is defined and totalPages > 1 %}
        <div class="pagination-container">
            {% if pageActuelle > 1 %}
                <a href="/student_list?page={{ pageActuelle - 1 }}&search={{ search|default('')|url_encode }}" class="btn">
                    Précédent
                </a>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="/student_list?page={{ i }}&search={{ search|default('')|url_encode }}"
                   class="btn" style="{{ i == pageActuelle ? 'background:#17496E;' : '' }}">
                <a href="/student_list?page={{ i }}" class="pagination-btn {{ i == pageActuelle ? 'is-active' : '' }}">
                    {{ i }}
                </a>
            {% endfor %}

            {% if pageActuelle < totalPages %}
                <a href="/student_list?page={{ pageActuelle + 1 }}&search={{ search|default('')|url_encode }}" class="btn">
                    Suivant
                </a>
            {% endif %}
        </div>
    {% endif %}
</main>

{% include 'partials/_footer.html.twig' %}

</body>
</html>